{
  "name": "@stbr/solana-stablecoin-standard",
  "version": "0.1.0",
  "private": true,
  "description": "Solana Stablecoin Standard (SSS) — modular SDK and open standards for stablecoins on Solana",
  "workspaces": [
    "sdk/core",
    "services/*"
  ],
  "scripts": {
    "build": "yarn workspaces run build",
    "test": "anchor test",
    "test:local": "anchor test --skip-local-validator",
    "sss-token": "./scripts/sss-token",
    "sss-token:install": "./scripts/install-sss-token.sh",
    "test:sdk": "yarn workspaces run test",
    "clean": "yarn workspaces run clean",
    "test:sss1": "anchor test --skip-build --skip-lint tests/sss-1.ts",
    "test:sss2": "anchor test --skip-build --skip-lint tests/sss-2.ts",
    "test:integration": "anchor test --skip-build --skip-lint tests/integration.ts",
    "test:indexer": "yarn workspace @stbr/sss-indexer run test",
    "test:webhook": "yarn workspace @stbr/sss-webhook run test",
    "test:services": "yarn test:indexer && yarn test:webhook",
    "lint": "eslint 'sdk/core/src/**/*.ts' 'services/*/src/**/*.ts' 'tests/**/*.ts'",
    "lint:fix": "yarn lint --fix",
    "format": "prettier --write 'sdk/core/src/**/*.ts' 'services/*/src/**/*.ts' 'tests/**/*.ts'",
    "format:check": "prettier --check 'sdk/core/src/**/*.ts' 'services/*/src/**/*.ts' 'tests/**/*.ts'"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.31.1",
    "@solana/spl-token": "^0.4.10",
    "@solana/web3.js": "^1.98.0"
  },
  "devDependencies": {
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "chai": "^4.5.0",
    "eslint": "^8.57.0",
    "mocha": "^10.8.2",
    "prettier": "^3.4.0",
    "ts-mocha": "^10.0.0",
    "typescript": "^5.7.3"
  }
}
