{
  "name": "@stbr/solana-stablecoin-standard",
  "version": "0.1.0",
  "private": true,
  "description": "Solana Stablecoin Standard (SSS) — modular SDK and open standards for stablecoins on Solana",
  "workspaces": [
    "sdk/core",
    "services/*"
  ],
  "scripts": {
    "build": "yarn workspaces foreach -A run build",
    "test": "anchor test",
    "test:local": "anchor test --skip-local-validator",
    "test:sdk": "yarn workspaces foreach -A run test",
    "clean": "yarn workspaces foreach -A run clean",
    "test:sss1": "yarn run ts-mocha -p ./tsconfig.json -t 1000000 tests/sss-1.ts",
    "test:sss2": "yarn run ts-mocha -p ./tsconfig.json -t 1000000 tests/sss-2.ts",
    "test:integration": "yarn run ts-mocha -p ./tsconfig.json -t 1000000 tests/integration.ts",
    "lint": "eslint 'sdk/core/src/**/*.ts' 'services/*/src/**/*.ts' 'tests/**/*.ts'",
    "lint:fix": "yarn lint --fix",
    "format": "prettier --write 'sdk/core/src/**/*.ts' 'services/*/src/**/*.ts' 'tests/**/*.ts'",
    "format:check": "prettier --check 'sdk/core/src/**/*.ts' 'services/*/src/**/*.ts' 'tests/**/*.ts'"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.31.1",
    "@solana/spl-token": "^0.4.10",
    "@solana/web3.js": "^1.98.0"
  },
  "devDependencies": {
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "chai": "^4.5.0",
    "eslint": "^8.57.0",
    "mocha": "^10.8.2",
    "prettier": "^3.4.0",
    "ts-mocha": "^10.0.0",
    "typescript": "^5.7.3"
  }
}
